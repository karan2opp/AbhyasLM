# Postgres connection string (docker-compose.yml default shown)
DATABASE_URL=postgres://abhyaslm:abhyaslm@127.0.0.1:5456/abhyaslm_db

PORT=8000

# From your Clerk dashboard (clerk.com)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Any random string — encrypts examiners' own API keys at rest (AES-256)
ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins (CORS + Clerk)
FRONTEND_URL=http://localhost:3000

# Platform fallback model keys, used when an examiner hasn't set their own
OPENAI_API_KEY=
MISTRAL_API_KEY=

GENERATION_MODEL=mistral-small-latest
EVALUATION_MODEL=mistral-small-latest
GUARDRAIL_MODEL=mistral-small-latest
EMBEDDING_MODEL=text-embedding-3-small

# File uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vector search — defaults to the local Qdrant from docker-compose.yml
QDRANT_URL=http://127.0.0.1:6343
QDRANT_API_KEY=

# Background jobs — omit both to use the local Inngest dev server
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_DEV=1

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=

# Path to a python3 executable with PyMuPDF installed
PYTHON_BIN=python3
